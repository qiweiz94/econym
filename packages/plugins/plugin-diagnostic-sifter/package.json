{
  "name": "@econym/dsh-plugin-diagnostic-sifter",
  "description": "run_diagnostic_check tool: sifted typecheck/test diagnostics — root causes only, cascades suppressed, bounded output",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiweiz94/econym.git",
    "directory": "packages/plugins/plugin-diagnostic-sifter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.0 <0.2.0",
    "@deepseek-ai/dsh-output-retention": ">=0.1.0-rc.0 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.0 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.0 <0.2.0",
    "@deepseek-ai/cordis": ">=4.0.1 <5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/cordis": "4.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json"
  }
}
